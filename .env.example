# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optionnel — signe le cookie de rôle vendeur (32+ caractères aléatoires)
SELLER_COOKIE_SECRET=
# Optionnel — chiffre les mots de passe commerçants visibles par l'admin (ne plus changer ensuite)
OWNER_PASSWORD_KEY=
# Optionnel — signe la purge du cache de production depuis un autre environnement (même valeur partout)
REVALIDATE_SECRET=

# App — origine publique écrite sur les cartes NFC (jamais localhost, même en dev)
NEXT_PUBLIC_SITE_URL=https://bitaqa-project.vercel.app
